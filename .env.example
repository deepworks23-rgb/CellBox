# PostgreSQL Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:password@host/CellBox?sslmode=require&channel_binding=require"

# Session signing secret (generate a long random string in production)
SESSION_SECRET="replace-with-a-secure-random-secret"

# S3-Compatible Object Storage
S3_BUCKET="assets"
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Transactional Email (Real Password Recovery — configure Resend OR SMTP)
MAIL_FROM="Cellbox <no-reply@cellbox.co.mz>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Optional Runtime Environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
